{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "nextjs", "typescript", "import", "jsx-a11y"],
  "env": {
    "browser": true,
    "node": true,
    "es2026": true
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/unsupported-syntax": "warn"
  },
  "settings": {
    "next": {
      "rootDir": "."
    }
  },
  "ignorePatterns": ["node_modules/**", ".next/**", ".vercel/**", "next-env.d.ts", "*.tsbuildinfo"]
}

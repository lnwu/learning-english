rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isPreviewWriter() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function validWord(d) {
      return d.keys().hasOnly(['word', 'translation', 'correctCount', 'totalAttempts', 'inputTimes', 'lastPracticedAt', 'correctPracticeDates', 'attemptHistory', 'createdAt'])
        && d.word is string && d.word.size() > 0 && d.word.size() <= 100
        && d.translation is string && d.translation.size() <= 4000
        && d.correctCount is int && d.correctCount >= 0 && d.correctCount <= 10000000
        && d.totalAttempts is int && d.totalAttempts >= 0 && d.totalAttempts <= 10000000
        && d.inputTimes is list && d.inputTimes.size() <= 20
        && d.inputTimes.every(x, x is number && x >= 0 && x <= 31536000)
        && (d.lastPracticedAt == null || d.lastPracticedAt is timestamp)
        && ('correctPracticeDates' !in d
            || (d.correctPracticeDates is list
                && d.correctPracticeDates.size() <= 30
                && d.correctPracticeDates.every(s, s is string && s.size() == 10)))
        && ('attemptHistory' !in d
            || (d.attemptHistory is list
                && d.attemptHistory.size() <= 30
                && d.attemptHistory.every(b, b is bool)))
        && ('createdAt' !in d || d.createdAt is timestamp);
    }

    function validPracticeTime(d) {
      return d.keys().hasOnly(['seconds'])
        && d.seconds is number && d.seconds >= 0 && d.seconds <= 4320000;
    }

    match /users/{userId}/words/{wordId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validWord(request.resource.data);
      allow delete: if isOwner(userId);
    }

    match /users/preview/words/{wordId} {
      allow read: if signedIn();
      allow create, update: if isPreviewWriter() && validWord(request.resource.data);
      allow delete: if isPreviewWriter();
    }

    match /users/{userId}/practiceTime/{date} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validPracticeTime(request.resource.data);
      allow delete: if isOwner(userId);
    }

    match /users/preview/practiceTime/{date} {
      allow read: if signedIn();
      allow create, update: if isPreviewWriter() && validPracticeTime(request.resource.data);
      allow delete: if isPreviewWriter();
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /users/preview {
      allow read: if signedIn();
      allow write: if isPreviewWriter();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
